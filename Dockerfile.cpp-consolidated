# =============================================================================
# Consolidated Multi-Stage Dockerfile: HMM Engine + SG-DSP Engine
# Compile-once: both C++ nodes built in a single builder stage.
# Final images are minimal runtime containers with only the needed binaries.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: BUILDER — compiles both HMM and SG-DSP in one layer
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Base toolchain + all dependencies for both nodes
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    wget \
    gnupg \
    libzmq3-dev \
    libczmq-dev \
    libssl-dev \
    libasio-dev \
    libwebsocketpp-dev \
    nlohmann-json3-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# cppzmq headers (not available as apt package in Ubuntu 22.04)
RUN wget -q https://raw.githubusercontent.com/zeromq/cppzmq/master/zmq.hpp -O /usr/local/include/zmq.hpp && \
    wget -q https://raw.githubusercontent.com/zeromq/cppzmq/master/zmq_addon.hpp -O /usr/local/include/zmq_addon.hpp

# Intel MKL (for HMM node)
RUN wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB | apt-key add - && \
    echo "deb https://apt.repos.intel.com/oneapi all main" | tee /etc/apt/sources.list.d/oneAPI.list && \
    apt-get update && \
    apt-get install -y intel-oneapi-mkl-devel-2024.0 && \
    rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=/opt/intel/oneapi/mkl/latest/lib/intel64:$LD_LIBRARY_PATH
ENV MKLROOT=/opt/intel/oneapi/mkl/latest

# --- Build HMM Engine ---
WORKDIR /build/hmm
COPY Hidden-Markov-Model-MKL/ .
RUN mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_FLAGS="-msse3 -mfpmath=sse" \
          -DHMM_BUILD_TESTS=OFF \
          .. && \
    make -j$(nproc)

# --- Build SG-DSP Engine ---
WORKDIR /build/sg
COPY cpp-sg-dsp/ .
RUN mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make -j$(nproc)

# ---------------------------------------------------------------------------
# Stage 2a: HMM Runtime — minimal image with only the HMM binary
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS hmm-runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    libzmq5 \
    libssl3 \
    libgomp1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# MKL runtime libraries only (no devel headers)
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_rt.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_core.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_gnu_thread.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_intel_lp64.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_intel_thread.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_def.so.2 /usr/lib/
COPY --from=builder /opt/intel/oneapi/mkl/latest/lib/intel64/libmkl_avx2.so.2 /usr/lib/
RUN ldconfig

COPY --from=builder /build/hmm/build/hmm_engine /app/hmm_engine
WORKDIR /app
CMD ["./hmm_engine"]

# ---------------------------------------------------------------------------
# Stage 2b: SG-DSP Runtime — minimal image with only the SG binary
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS sg-runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libzmq5 \
    libcurl4 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/sg/build/sg_engine /app/sg_engine
WORKDIR /app
CMD ["./sg_engine"]
