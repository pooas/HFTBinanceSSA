                        "pluginVersion": "4.18.0",
                        "queryType": "timeseries",
                        "rawSql": "SELECT \n    timestamp AS time,\n    -- 🌟 Fused zero-lag trend (yellow): ssaMacroTrend + K_gain·sgSlope\n    ssa_smoothed AS zero_lag_trend,\n    -- Raw Ehlers macro trend for comparison (thin orange)\n    ssa_macro_trend,\n    -- Hysteresis deadband channel\n    band_upper,\n    band_lower,\n    -- Price dots coloured by Schmitt-trigger regime\n    CASE WHEN regime =  1 THEN price ELSE null END AS price_up,\n    CASE WHEN regime = -1 THEN price ELSE null END AS price_down\n\nFROM default.hft_market_data\nWHERE $__timeFilter(timestamp)\nORDER BY time ASC, sequence ASC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
