                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "timeseries",
                        "rawSql": "SELECT \n    timestamp AS time,\n    -- خط روند اصلی (زرد)\n    ssa_trend,\n    \n    -- قیمت وقتی بالاتر از ترند است (سبز)\n    CASE WHEN price >= ssa_trend THEN price ELSE null END AS price_up,\n    \n    -- قیمت وقتی پایین‌تر از ترند است (قرمز)\n    CASE WHEN price < ssa_trend THEN price ELSE null END AS price_down\n\nFROM default.hft_market_data\nWHERE $__timeFilter(timestamp)\nORDER BY time ASC, sequence ASC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
