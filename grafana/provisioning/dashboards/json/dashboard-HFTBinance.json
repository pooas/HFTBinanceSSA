      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "PDEE91DDB90597936"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "SELECT \n    time,\n    -- Strategy equity: compounded returns net of Binance taker fee (0.04%)\n    1000 * exp(SUM(log(greatest(1 + strat_ret_net, 0.00001))) OVER (ORDER BY time ASC, sequence ASC)) AS strategy_equity,\n    -- Buy & hold benchmark\n    1000 * exp(SUM(log(greatest(1 + mkt_ret_gross, 0.00001))) OVER (ORDER BY time ASC, sequence ASC)) AS buy_and_hold_equity\nFROM (\n    SELECT \n        time,\n        sequence,\n        mkt_ret_gross,\n        -- Net return = gross return - fee per position flip\n        (strat_ret_gross - (abs(current_signal - coalesce(prev_signal, 0)) * 0.0004)) AS strat_ret_net\n    FROM (\n        SELECT \n            time,\n            sequence,\n            current_signal,\n            prev_signal,\n            -- Market's gross return for this tick\n            if(prev_price > 0, (price - prev_price) / prev_price, 0) AS mkt_ret_gross,\n            -- Strategy gross return (before fees)\n            if(prev_price > 0, coalesce(prev_signal, 0) * ((price - prev_price) / prev_price), 0) AS strat_ret_gross\n        FROM (\n            SELECT \n                timestamp AS time,\n                sequence,\n                price,\n                -- Long/Short signal straight from the Java-computed\n                -- Schmitt-trigger regime (1=Bull, -1=Bear,=Held)\n                regime AS current_signal,\n                lagInFrame(price) OVER w AS prev_price,\n                lagInFrame(regime)    OVER w AS prev_signal\n            FROM default.hft_market_data\n            WHERE $__timeFilter(timestamp)\n            WINDOW w AS (ORDER BY timestamp ASC, sequence ASC)\n        )\n    )\n)\nORDER BY time ASC, sequence ASC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
