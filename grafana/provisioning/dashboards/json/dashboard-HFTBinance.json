      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Equity Curve-HFT",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efpeyyeztxhj4f"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "SELECT \n    time,\n    -- سرمایه استراتژی: محاسبه سود مرکب پس از کسر کارمزدهای بایننس\n    1000 * exp(SUM(log(greatest(1 + strat_ret_net, 0.00001))) OVER (ORDER BY time ASC, sequence ASC)) AS strategy_equity,\n    \n    -- سرمایه هولد کردن (بدون کارمزد، فقط برای مقایسه)\n    1000 * exp(SUM(log(greatest(1 + mkt_ret_gross, 0.00001))) OVER (ORDER BY time ASC, sequence ASC)) AS buy_and_hold_equity\nFROM (\n    SELECT \n        time,\n        sequence,\n        mkt_ret_gross,\n        -- کسر کارمزد از سود ناخالص:\n        -- فرمول: بازدهی ناخالص منهای (تعداد تغییر پوزیشن * کارمزد تیکر بایننس 0.0004)\n        (strat_ret_gross - (abs(current_signal - coalesce(prev_signal, 0)) * 0.0004)) AS strat_ret_net\n    FROM (\n        SELECT \n            time,\n            sequence,\n            current_signal,\n            prev_signal,\n            -- بازدهی خالص خودِ بازار در این تیک\n            if(prev_price > 0, (price - prev_price) / prev_price, 0) AS mkt_ret_gross,\n            -- بازدهی ناخالص استراتژی (قبل از کسر کارمزد)\n            if(prev_price > 0, coalesce(prev_signal, 0) * ((price - prev_price) / prev_price), 0) AS strat_ret_gross\n        FROM (\n            SELECT \n                timestamp AS time,\n                sequence,\n                price,\n                -- سیگنال فعلی\n                multiIf(price >= ssa_trend, 1, -1) AS current_signal,\n                -- قیمت و سیگنال در تیک قبلی (Lag)\n                lagInFrame(price) OVER w AS prev_price,\n                lagInFrame(multiIf(price >= ssa_trend, 1, -1)) OVER w AS prev_signal\n            FROM default.hft_market_data\n            WHERE $__timeFilter(timestamp)\n            WINDOW w AS (ORDER BY timestamp ASC, sequence ASC)\n        )\n    )\n)\nORDER BY time ASC, sequence ASC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
